{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "universal-fintech-motion-skills",
  "version": "1.0.0",
  "description": "55 universal AI agent skills that generate self-contained HTML5 fintech motion and explanation videos using HTML5, TailwindCSS, Vanilla JS and inline SVG.",
  "license": "GPL-3.0",
  "masterPrompt": "./master-prompt.md",
  "entrypoint": {
    "instructions": "./master-prompt.md",
    "skillIndex": "../skills/",
    "demo": "../demos/stripe-flow-explainer.html"
  },
  "compatibility": [
    "claude-code",
    "cursor",
    "windsurf",
    "antigravity",
    "manus",
    "qoder",
    "jarvis",
    "cue",
    "grok",
    "codex",
    "github-copilot"
  ],
  "configFiles": {
    "claude-code": "../CLAUDE.md",
    "cursor": "../.cursorrules",
    "windsurf": "../.windsurfrules",
    "github-copilot": "../.github/copilot-instructions.md",
    "universal": "../AGENTS.md"
  },
  "runtime": {
    "outputFormat": "single-html-file",
    "stack": ["html5", "tailwindcss-cdn", "vanilla-js", "inline-svg"],
    "requiresBuildStep": false,
    "requiresNetwork": ["https://cdn.tailwindcss.com", "https://fonts.googleapis.com"],
    "offlineFallback": "Inline CSS custom properties mirror every Tailwind utility used for layout, so the file renders without the CDN."
  },
  "engine": {
    "class": "TimelineEngine",
    "stateModel": "pure-function-of-normalized-progress",
    "drivingLoop": "requestAnimationFrame",
    "capabilities": [
      "play-pause-replay",
      "click-and-drag-scrubber",
      "click-to-seek",
      "scene-boundary-markers",
      "step-indicator",
      "live-captions",
      "speed-1x-1.5x-2x",
      "theme-toggle",
      "keyboard-shortcuts"
    ],
    "defaults": {
      "duration": 16000,
      "speed": 1,
      "sceneCount": 4
    }
  },
  "designSystem": {
    "light": {
      "canvas": "#F8FAFC",
      "surface": "#FFFFFF",
      "text": "#0F172A",
      "muted": "#64748B",
      "border": "#E2E8F0",
      "success": "#10B981",
      "primary": "#4F46E5",
      "telemetry": "#06B6D4",
      "risk": "#F43F5E"
    },
    "dark": {
      "canvas": "#090D16",
      "surface": "rgba(255,255,255,0.03)",
      "text": "#F8FAFC",
      "muted": "#94A3B8",
      "border": "rgba(255,255,255,0.08)",
      "success": "#34D399",
      "primary": "#6366F1",
      "telemetry": "#22D3EE",
      "risk": "#FB7185"
    },
    "type": {
      "ui": ["Inter", "Plus Jakarta Sans"],
      "data": ["JetBrains Mono"],
      "numericFeature": "tabular-nums"
    },
    "motion": {
      "entry": "cubic-bezier(0.16, 1, 0.3, 1)",
      "symmetric": "cubic-bezier(0.65, 0, 0.35, 1)",
      "spring": { "stiffness": 220, "damping": 24 },
      "linearAllowedFor": ["realtime-countdown", "ambient-rotation"]
    }
  },
